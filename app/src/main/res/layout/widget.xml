<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg"
    android:padding="14dp"
    android:layoutDirection="rtl"
    android:id="@+id/w_root">

    <!-- سطر بالا: عنوان بلوک فعلی + ساعت -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F4F4F5"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />

        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#8A8A93"
            android:background="@drawable/w_pill"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="" />
    </LinearLayout>

    <!-- توضیح بلوک -->
    <TextView
        android:id="@+id/w_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#8A8A93"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:text="" />

    <!-- نوار پیشرفت بلوک -->
    <ProgressBar
        android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/w_prog" />

    <!-- بلوک بعدی -->
    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="11.5sp"
        android:textColor="#C9C9D0"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- پایین: کوئست و استریک -->
    <TextView
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="10.5sp"
        android:textColor="#5C5C66"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
