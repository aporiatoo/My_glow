# این فایل را به keystore.properties کپی کن و مقادیر را پر کن.
# keystore.properties در .gitignore است و هرگز آپلود نمی‌شود.
#
# ساخت کلید (یک بار، و برای همیشه نگهش دار):
#   keytool -genkeypair -v -keystore ascend.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias ascend
#
storeFile=../ascend.jks
storePassword=CHANGEME
keyAlias=ascend
keyPassword=CHANGEME
